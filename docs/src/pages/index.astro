---
// SPDX-License-Identifier: Apache-2.0
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import FamilyRoutes from '../components/FamilyRoutes.astro';
import DecisionReceipt from '../components/DecisionReceipt.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}/${path}`;
const frontmatter = {
  title: 'Seal — approval for selected AI-agent tool calls',
  description: 'Seal is a local approval gate for selected Claude Code MCP tool calls.',
  template: 'splash' as const,
  hero: { title: 'Review risky tool calls before they run.' },
};
---
<StarlightPage frontmatter={frontmatter}>
  <section class="three-columns" aria-label="How approval works">
    <div><h2>Choose the calls</h2><p>Select the tools that need a human decision. Other tools on that route pass through without approval.</p></div>
    <div><h2>Bind each approval</h2><p>Review the tool and its arguments. An approval cannot authorize a second execution.</p></div>
    <div><h2>Inspect the decision</h2><p>Keep a signed decision receipt. Check its signature and replay separately; it does not prove an effect occurred.</p></div>
  </section>
  <section class="demo-band" aria-label="Try the demo">
    <div><p><strong>Start with the harmless demo.</strong> Run it locally to inspect your own approval and replay outcome.</p>
    <p>Approve the exact tool call.</p></div><code>seal demo</code>
  </section>
  <p class="illustration-note">Recorded CLI transcript, not a captured client session. Run the demo after installing Seal.</p>
  <section aria-labelledby="guarantees-limits" class="evidence-callout">
    <h2 id="guarantees-limits">Guarantees &amp; limits</h2>
    <p>Seal is a local approval gate for selected Claude Code MCP tool calls. Review the exact request,
      allow at most one execution per approval, and inspect a signed decision receipt.</p>
    <p>Seal is a gate, not a sandbox. Calls and effects outside the configured Seal route remain outside its control.</p>
    <p>
      The decision leaves a signed receipt. Open it in the
      <a href={link('check/')}>browser checker</a> or use the assurance CLI to see what the
      recorded evidence establishes.
    </p>
    <p>
      The companion tools let you check recorded evidence separately from the running Seal
      deployment. The browser checker and CLI share kernel and receipt-format dependencies, so
      their agreement can also reflect a shared defect. A passing receipt check establishes only
      the properties it reports; it does not by itself establish operator identity or prove that a
      tool effect occurred.
    </p>
    <p>
      Lean proofs cover specified decision-model properties. Seal currently documents that
      correspondence between its proved authorization model and shipped authorization path is
      neither tested nor proved. Read the
      <a href={link('assurance/current-scope/')}>current assurance scope</a> for the evidence and
      remaining assumptions.
    </p>
  </section>

  <section aria-labelledby="explore-docs">
    <h2 id="explore-docs">Take it to your own tools</h2>
    <p>After the demo, choose what to protect, check a receipt, or explore the assurance tools.</p>
    <div class="home-receipt-row">
      <FamilyRoutes />
      <DecisionReceipt />
    </div>
    <ul class="explore-links">
      <li><a href={link('guide/what-is-protected-right-now/')}>Operate Seal</a></li>
      <li><a href={link('reference/receipt-operations/')}>Understand receipts</a></li>
      <li><a href={link('guide/when-something-looks-wrong/')}>Troubleshoot a refusal</a></li>
      <li><a href={link('assurance/architecture/')}>Architecture and verification relationships</a></li>
    </ul>
  </section>
</StarlightPage>
<style>
  section { margin-block-start: 3rem; }
  section > p { max-width: 75ch; }
  .three-columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; border-top: 1px solid var(--seal-border); padding-top: 1.75rem; }
  .three-columns h2 { font-size: 1.05rem; margin: 0 0 .65rem; }
  .three-columns p, .illustration-note { font-size: .875rem; color: var(--seal-muted); }
  .three-columns > div { margin: 0; }
  .demo-band { display: flex; gap: 2rem; align-items: center; justify-content: space-between; background: var(--seal-surface); padding: 1.5rem; border-radius: var(--seal-radius); }
  .demo-band p { margin: 0; }
  .demo-band p + p { color: var(--seal-muted); font-size: .875rem; margin-top: .5rem; }
  .demo-band code { white-space: nowrap; }
  .evidence-callout { border-top: 1px solid var(--seal-border); padding-top: 2rem; }
  .explore-links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; list-style: none; padding: 0; }
  .home-receipt-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 26rem); gap: 2.5rem; align-items: start; margin-top: 2rem; }
  .home-receipt-row :global(.family-routes) { margin: 0; }
  @media (max-width: 49.99rem) {
    .three-columns, .home-receipt-row { grid-template-columns: 1fr; }
    .demo-band { align-items: start; flex-direction: column; gap: 1rem; }
  }
</style>
