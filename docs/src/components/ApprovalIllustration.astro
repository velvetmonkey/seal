---
// Illustrates the 0 → 1 → 1 call count observed in `seal demo`.
// The example tool/arguments are fictional; this component executes no tool.
---
<figure class="approval-story" data-approval-demo>
  <figcaption>Interactive illustration, example files server, no tool executes</figcaption>
  <div class="approval-card">
    <div class="card-header"><span>Claude Code → Seal → files</span><span data-step aria-label="Step 1 of 3">01 / 03</span></div>
    <div class="card-body">
      <p class="state-heading" data-heading>WAITING FOR YOUR DECISION</p>
      <dl><dt>Tool</dt><dd>delete_file</dd><dt>Server</dt><dd>files · selected route</dd></dl>
      <pre aria-label="Tool arguments"><code>{'{\n  "path": "./drafts/old-notes.md"\n}'}</code></pre>
      <p class="scope">This request only. At most one execution.</p>
      <div class="controls">
        <button type="button" data-approve>Approve once</button>
        <button type="button" data-decline>Decline</button>
        <button type="button" data-replay hidden>Replay the approval</button>
        <button type="button" data-reset hidden>Reset</button>
      </div>
      <noscript>Enable JavaScript to try this illustration. No tool executes.</noscript>
    </div>
    <p class="result" role="status" aria-live="polite" aria-atomic="true">Calls forwarded: 0. The request is held at the gate.</p>
  </div>
</figure>
<script>
  const card = document.querySelector<HTMLElement>('[data-approval-demo]');
  if (card) {
    const approve = card.querySelector<HTMLButtonElement>('[data-approve]')!;
    const decline = card.querySelector<HTMLButtonElement>('[data-decline]')!;
    const replay = card.querySelector<HTMLButtonElement>('[data-replay]')!;
    const reset = card.querySelector<HTMLButtonElement>('[data-reset]')!;
    const heading = card.querySelector<HTMLElement>('[data-heading]')!;
    const step = card.querySelector<HTMLElement>('[data-step]')!;
    const status = card.querySelector<HTMLElement>('[role="status"]')!;
    type State = 'waiting' | 'approved' | 'replayed' | 'declined';
    let state: State = 'waiting';
    const render = (next: State) => {
      state = next;
      const waiting = state === 'waiting';
      approve.hidden = decline.hidden = !waiting;
      replay.hidden = state !== 'approved';
      reset.hidden = waiting;
      const number = waiting ? 1 : state === 'replayed' ? 3 : 2;
      step.textContent = `0${number} / 03`;
      step.setAttribute('aria-label', `Step ${number} of 3`);
      heading.textContent = { waiting: 'WAITING FOR YOUR DECISION', approved: 'APPROVED ONCE', replayed: 'REPLAY REFUSED — BLOCK', declined: 'DECLINED' }[state];
      status.textContent = {
        waiting: 'Calls forwarded: 0. The request is held at the gate.',
        approved: 'Calls forwarded: 1. Approved once. The call ran once in this illustration.',
        replayed: 'Calls forwarded: 1. Replay refused — BLOCK. The repeated approval did not run the call again.',
        declined: 'Calls forwarded: 0. Declined.',
      }[state];
      (waiting ? approve : state === 'approved' ? replay : reset).focus();
    };
    approve.addEventListener('click', () => { if (state === 'waiting') render('approved'); });
    decline.addEventListener('click', () => { if (state === 'waiting') render('declined'); });
    replay.addEventListener('click', () => { if (state === 'approved') render('replayed'); });
    reset.addEventListener('click', () => render('waiting'));
  }
</script>
<style>
  .approval-story { margin: .5rem 0 0; min-width: 0; }
  figcaption { color: var(--seal-muted); font-size: .8125rem; line-height: 1.5; margin-bottom: .75rem; }
  .approval-card { background: var(--seal-surface); border: 1px solid var(--seal-border); border-radius: .625rem; overflow: hidden; }
  .card-header { display: flex; justify-content: space-between; align-items: center; gap: .5rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--seal-border); color: var(--seal-muted); font: .8125rem/1.5 ui-monospace, monospace; }
  .card-body { padding: 1.5rem; }
  .state-heading { color: var(--seal-accent); font: 600 .8125rem/1.5 ui-monospace, monospace; margin: 0 0 1.5rem; }
  dl { display: grid; grid-template-columns: 5rem 1fr; gap: .5rem 1rem; font: .875rem/1.6 ui-monospace, monospace; margin: 0 0 1.25rem; }
  dt { color: var(--seal-muted); } dd { margin: 0; }
  pre { background: var(--seal-bg); color: var(--seal-text); padding: 1rem; border-radius: .25rem; font: .8125rem/1.9 ui-monospace, monospace; overflow-x: auto; white-space: pre-wrap; overflow-wrap: anywhere; margin: 0; }
  .scope { color: var(--seal-muted); font-size: .875rem; margin: 1.25rem 0; }
  .controls { display: flex; flex-wrap: wrap; gap: .625rem; }
  button { font: inherit; font-size: .875rem; padding: .75rem 1rem; min-height: 44px; cursor: pointer; background: var(--seal-bg); color: var(--seal-text); border: 1px solid var(--seal-border); border-radius: .25rem; }
  button[data-approve], button[data-replay] { background: var(--seal-accent); color: var(--seal-accent-text); border-color: var(--seal-accent); }
  button[hidden] { display: none; }
  button:focus-visible, pre:focus-visible { outline: 2px solid var(--seal-accent); outline-offset: 3px; }
  .result { border-top: 1px solid var(--seal-border); margin: 0; padding: 1rem 1.5rem; font: .8125rem/1.8 ui-monospace, monospace; min-height: 6rem; }
  @media (max-width: 26rem) { .card-body { padding: 1rem; } .card-header { padding: 1rem; font-size: .75rem; } dl { grid-template-columns: 3.5rem 1fr; } pre { padding: .75rem; font-size: .75rem; } .result { padding: 1rem; } }
  /* No animation or transition: all states also work with reduced motion. */
</style>
