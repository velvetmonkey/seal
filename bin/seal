#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// The product shell.
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const crypto = require("node:crypto");
const { pathToFileURL } = require("node:url");
const readline = require("node:readline");
const { requireMatchingVersion } = require(path.join(path.resolve(__dirname, ".."), "spine", "version.cjs"));
const { requireProtectSupportedPlatform } = require(path.join(path.resolve(__dirname, ".."), "spine", "platform.cjs"));
const receiptPopulation = require(path.join(path.resolve(__dirname, ".."), "spine", "receipt-population.cjs"));

const ROOT = path.resolve(__dirname, "..");
const reproduceOwner = require(path.join(ROOT, "scripts", "seal-reproduce.cjs"));
const manifest = JSON.parse(fs.readFileSync(path.join(ROOT, "runtime-manifest.json"), "utf8"));
const cache = path.join(process.env.SEAL_CACHE_DIR || path.join(os.homedir(), ".cache", "seal"), "runtime", manifest.commit);
const shippedRuntime = path.join(ROOT, "runtime");
const shippedRuntimeFiles = Object.entries(manifest.files).filter(([relative]) => relative.startsWith("kernel/"));

function sha256(bytes) { return crypto.createHash("sha256").update(bytes).digest("hex"); }
function inspectRuntimeAt(directory, files) {
  for (const [relative, expected] of files) {
    const target = path.join(directory, relative);
    try {
      if (!fs.statSync(target).isFile()) return { present: false, state: "absent", reason: `${relative} is not a file` };
      const got = sha256(fs.readFileSync(target));
      if (got !== expected) return { present: false, state: "integrity check failed", reason: `${relative} hash mismatch` };
    } catch (error) {
      return { present: false, state: "absent", reason: `${relative} is unavailable` };
    }
  }
  return { present: true };
}
function inspectRuntime() {
  // The installed artifact ships the kernel, while src/verify.cjs is fetched
  // into the cache for the optional verification command. Never treat a bad
  // shipped kernel as a reason to use an unchecked fallback.
  const shipped = inspectRuntimeAt(shippedRuntime, shippedRuntimeFiles);
  if (shipped.present || shipped.state === "integrity check failed") return shipped;
  return inspectRuntimeAt(cache, Object.entries(manifest.files));
}
function status() {
  // Status derives ACTIVE/STALE from Linux process-start witnesses. Keep this
  // product path behind the same platform refusal as `seal __proxy`.
  requireProtectSupportedPlatform();
  const protection = require(path.join(ROOT, "spine", "protection.cjs"));
  const runtime = inspectRuntime();
  console.log(runtime.present
    ? `Runtime at status check: kernel payload bytes matched runtime-manifest.json for seal-assurance-kit@${manifest.commit}; per-authorization installed-tree and Node-floor judgments have not yet been observed.`
    : runtime.state === "integrity check failed"
      ? `Runtime at status check FAIL: integrity check failed seal-assurance-kit@${manifest.commit} (${runtime.reason}; runtime bytes do not match the published runtime)`
      : `Runtime at status check UNKNOWN: absent seal-assurance-kit@${manifest.commit} (${runtime.reason})`);
  const { projectRoot, installedRecords } = printReachabilityObservation(protection, process.cwd(), process.env);

  let paths;
  try { paths = protection.statePathsFor(projectRoot, process.env); }
  catch (error) { statusRecord(undefined, projectRoot, error); return; }
  paths = [...new Set([...paths, ...installedRecords.keys()])];
  for (const filePath of paths.length ? paths : [undefined]) {
    statusRecord(filePath, installedRecords.get(filePath) || projectRoot);
  }
}

// JSON.parse validates syntax, but loses repeated object members. Walk the raw
// tokens iteratively so deep unrelated metadata cannot overflow the JS stack.
// Only MCP definitions and the keys selecting their scope affect this inventory.
function statusDuplicateKeys(text, projectRoot) {
  const stack = [];
  const duplicates = new Set();
  for (let i = 0; i < text.length;) {
    const c = text[i];
    const parent = stack[stack.length - 1];
    if (c === '"') {
      const start = i++;
      while (i < text.length) {
        if (text[i] === "\\") { i += 2; continue; }
        if (text[i++] === '"') break;
      }
      if (parent?.object && parent.keyNext) {
        const key = JSON.parse(text.slice(start, i));
        parent.key = key;
        parent.keyNext = false;
        const relevant = parent.role === "definition" || parent.role === "servers"
          || ((parent.role === "root" || parent.role === "local") && key === "mcpServers")
          || (parent.role === "root" && projectRoot !== undefined && key === "projects")
          || (parent.role === "projects" && key === projectRoot);
        if (relevant) {
          if (parent.keys.has(key)) duplicates.add(key);
          parent.keys.add(key);
        }
      }
      continue;
    }
    if (c === "{" || c === "[") {
      let role = "ignored";
      if (!parent) role = "root";
      else if (parent.role === "servers" || parent.role === "definition") role = "definition";
      else if (parent.object) {
        if ((parent.role === "root" || parent.role === "local") && parent.key === "mcpServers") role = "servers";
        else if (parent.role === "root" && projectRoot !== undefined && parent.key === "projects") role = "projects";
        else if (parent.role === "projects" && parent.key === projectRoot) role = "local";
      }
      stack.push({ object: c === "{", keyNext: c === "{", role, keys: new Set() });
    } else if (c === "}" || c === "]") stack.pop();
    else if (c === "," && parent?.object) parent.keyNext = true;
    i++;
  }
  return [...duplicates];
}

function statusJsonSource(filePath, label, projectRoot) {
  try {
    const bytes = fs.readFileSync(filePath);
    const text = bytes.toString("utf8");
    const parsed = JSON.parse(text);
    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) throw new Error("top-level value is not an object");
    const duplicates = statusDuplicateKeys(text, projectRoot);
    if (duplicates.length) return { label, filePath, error: `source has ambiguous definitions of duplicate keys ${duplicates.map((key) => JSON.stringify(key)).join(", ")}; client selection is UNKNOWN` };
    return { label, filePath, parsed };
  } catch (error) {
    const reason = error.code === "ENOENT" ? "source is missing" : `source cannot be read or is malformed (${error.message})`;
    return { label, filePath, error: reason };
  }
}

function statusScopeSources(root, env) {
  const configDir = env.CLAUDE_CONFIG_DIR || env.HOME || os.homedir();
  const configPath = path.join(configDir, ".claude.json");
  const projectRoot = (() => {
    try { return fs.realpathSync(require("node:child_process").execFileSync("git", ["-C", root, "rev-parse", "--show-toplevel"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim()); }
    catch { return fs.realpathSync(root); }
  })();
  const user = statusJsonSource(configPath, "user", projectRoot);
  const local = { label: "local", filePath: configPath };
  if (!user.error) local.parsed = user.parsed?.projects?.[projectRoot] || {};
  else local.error = user.error;
  const project = statusJsonSource(path.join(projectRoot, ".mcp.json"), "project");
  return { configPath, projectRoot, sources: [user, local, project] };
}

function printReachabilityObservation(protection, cwd, env) {
  const root = fs.realpathSync(cwd);
  const { configPath, projectRoot, sources } = statusScopeSources(root, env);
  console.log(`Observation project: ${projectRoot}`);
  console.log("Observation client: Claude Code static configuration; effective client route UNKNOWN");
  console.log(`Observation config: ${configPath}`);
  console.log(`Observation time: ${new Date().toISOString()}`);
  console.log("MCP scope precedence: local > project > user; plugins, connectors and managed/session sources are not inspected");
  console.log("Scopes inspected: user, local, project (direct files only; this is not a complete active inventory)");

  let states = [];
  let recordsError;
  try { states = protection.statePathsFor(projectRoot, env).map((filePath) => protection.readState(filePath)).filter(Boolean); }
  catch (error) { recordsError = error; console.log(`UNKNOWN — Installed wrapper records could not be inspected: ${error.message}`); }
  const installedRecords = new Map();
  const definitions = [];
  let unknown = false;
  for (const source of sources) {
    if (source.error) { console.log(`UNKNOWN — ${source.label} MCP configuration ${source.error}: ${source.filePath}`); unknown = true; continue; }
    const servers = source.parsed?.mcpServers;
    if (servers === undefined) { console.log(`UNKNOWN — ${source.label} MCP configuration has no inspectable mcpServers object`); unknown = true; continue; }
    if (!servers || typeof servers !== "object" || Array.isArray(servers)) { console.log(`UNKNOWN — ${source.label} MCP configuration mcpServers is malformed`); unknown = true; continue; }
    for (const [name, definition] of Object.entries(servers)) definitions.push({ source: source.label, name, definition });
  }
  const byName = new Map();
  for (const entry of definitions) (byName.get(entry.name) || (byName.set(entry.name, []), byName.get(entry.name))).push(entry);
  console.log("Observed MCP definitions (scoped configuration facts; not a complete active inventory):");
  for (const [name, entries] of [...byName.entries()].sort(([a], [b]) => a.localeCompare(b))) {
    const disagree = entries.some((entry) => protection.canonical(entry.definition) !== protection.canonical(entries[0].definition));
    const scopes = entries.map((entry) => entry.source).join(", ");
    if (disagree) console.log(`  UNKNOWN — entry ${JSON.stringify(name)} has conflicting definitions across ${scopes}; scope shadowing and approval eligibility are unresolved`);
    const local = entries.find((entry) => entry.source === "local");
    const recorded = states.find((candidate) => candidate.serverName === name);
    const wrapperLike = (definition) => Array.isArray(definition?.args) &&
      definition.args.some((arg) => arg === "__proxy" || arg === "--protect-state");
    if (recordsError || recorded || entries.some((entry) => wrapperLike(entry.definition))) {
      try {
        if (recordsError) throw recordsError;
        if (!local) throw new Error("no inspected local wrapper establishes ownership");
        // A wrapper can have been installed from a child directory. Its record
        // owns that installation root, while Claude selects the repository scope.
        const args = local.definition?.args;
        const recordPath = Array.isArray(args) && args[0] === "__proxy" &&
          args[1] === "--protect-state" && args.length === 3 && typeof args[2] === "string"
          ? path.resolve(projectRoot, args[2]) : null;
        const state = recordPath ? protection.readState(recordPath) : recorded;
        if (!state) throw new Error("installed wrapper protection record is unavailable");
        if (protection.canonical(local.definition) !== protection.canonical(state.localOverride?.definition)) throw new Error("local definition does not match the installed wrapper");
        const installationRoot = state.projectRoot;
        if (typeof installationRoot !== "string" ||
            protection.claudeProjectRoot(installationRoot) !== projectRoot) throw new Error("installed wrapper project scope does not match the inspected project");
        protection.assertSealOwnedLocalOverride(state, installationRoot, name, env);
        // Child installations keep their own state directory even though Claude
        // selects the Git scope. Only enumerate records in this data home.
        if (recordPath && protection.statePathsFor(installationRoot, env).includes(recordPath)) {
          installedRecords.set(recordPath, installationRoot);
        }
        const selections = protection.protectedToolSelections(state).map(({ name: tool, predicate }) => predicate === null ? tool : `${tool}?${predicate}`).join(", ");
        console.log(`  BROKERED — Local MCP entry ${JSON.stringify(name)} matches Seal's installed wrapper; this wrapper gates ${selections}. Client use of this entry is UNKNOWN.`);
      } catch (error) { console.log(`  UNKNOWN — installed wrapper ${JSON.stringify(name)} could not establish its guarded predicates: ${error.message}`); unknown = true; }
    } else if (entries.some(({ definition }) => !definition || typeof definition !== "object" ||
        Array.isArray(definition) || !(typeof definition.command === "string" || typeof definition.url === "string"))) {
      console.log(`  UNKNOWN — entry ${JSON.stringify(name)} has no inspectable command or URL; ownership cannot be established`);
      unknown = true;
    } else {
      console.log(`  UNBROKERED — Inspected ${entries[0].source} MCP entry ${JSON.stringify(name)} is configured without Seal; whether this client session can use it is UNKNOWN.`);
    }
  }
  if (definitions.length === 0 && !unknown) console.log("  UNKNOWN — no direct MCP definitions were observed");
  console.log("UNKNOWN — Client route completeness has not been established: Seal cannot confirm this session's effective MCP, shell or network access.");
  console.log("Boundary: shell and network routes are outside this Seal MCP wrapper; their effective reachability is UNKNOWN.");
  return { projectRoot, installedRecords };
}

// Coverage is an inventory of known routes, not a containment claim.  In
// particular, a saved protect record is not enough: the wrapper must still be
// owned by this tree and its lease must be live. This is inference, not a probe.
function coverage() {
  requireProtectSupportedPlatform();
  const protection = require(path.join(ROOT, "spine", "protection.cjs"));
  console.log("Coverage enumeration is not proven complete.");
  console.log("Coverage BROKERED requires a live lease; status BROKERED describes static wrapper ownership. A PENDING RESTART wrapper is UNKNOWN here even when status reports BROKERED; client use remains UNKNOWN.");
  const { projectRoot, sources } = statusScopeSources(fs.realpathSync(process.cwd()), process.env);
  console.log(`Coverage project: ${projectRoot}; scopes: user, local, project (same direct configuration sources as status; effective client selection UNKNOWN)`);
  const byName = new Map();
  for (const source of sources) {
    const servers = source.parsed?.mcpServers;
    if (source.error || !servers || typeof servers !== "object" || Array.isArray(servers)) {
      console.log(`Scope UNKNOWN — ${source.label} MCP configuration ${source.error || "has no inspectable mcpServers object"}: ${source.filePath}`);
      continue;
    }
    for (const [name, definition] of Object.entries(servers)) {
      if (!byName.has(name)) byName.set(name, []);
      byName.get(name).push({ source: source.label, definition });
    }
  }
  const records = new Map();
  let recordsError;
  try {
    for (const statePath of protection.statePathsFor(projectRoot, process.env)) {
      try { records.set(statePath, { state: protection.readState(statePath) }); }
      catch (error) { records.set(statePath, { error }); }
    }
  } catch (error) { recordsError = error; }
  const usedRecords = new Set();
  for (const [name, entries] of [...byName.entries()].sort(([a], [b]) => a.localeCompare(b))) {
    const label = `selected MCP tools on ${name}`;
    const local = entries.find((entry) => entry.source === "local");
    const args = local?.definition?.args;
    const statePath = Array.isArray(args) && args[0] === "__proxy" &&
      args[1] === "--protect-state" && args.length === 3 && typeof args[2] === "string"
      ? path.resolve(projectRoot, args[2]) : null;
    const matching = [...records.entries()].filter(([file, record]) => record.state?.serverName === name ||
      (record.error && path.basename(path.dirname(path.dirname(file))) === "servers" &&
        path.basename(path.dirname(file)) === encodeURIComponent(name).replaceAll(".", "%2E")));
    for (const [file] of matching) usedRecords.add(file);
    if (statePath) usedRecords.add(statePath);
    const wrapperLike = entries.some(({ definition }) => Array.isArray(definition?.args) &&
      definition.args.some((arg) => arg === "__proxy" || arg === "--protect-state"));
    try {
      if (recordsError) throw recordsError;
      // A damaged record cannot supply its serverName; locate the server's
      // canonical record too, so damage is not mistaken for absence.
      const expectedPath = statePath || matching[0]?.[0];
      if (records.has(expectedPath)) {
        usedRecords.add(expectedPath);
        if (records.get(expectedPath).error) throw records.get(expectedPath).error;
      }
      if (statePath || matching.length || records.has(expectedPath) || wrapperLike) {
        if (!local) throw new Error("no inspected local wrapper establishes ownership");
        const state = statePath ? protection.readState(statePath) : matching[0]?.[1].state;
        if (!state) throw new Error("installed wrapper protection record is unavailable");
        printObservedClient(state);
        if (state.serverName !== name || typeof state.projectRoot !== "string" ||
            protection.claudeProjectRoot(state.projectRoot) !== projectRoot) throw new Error("installed wrapper server or project scope does not match the inspected entry");
        if (protection.canonical(local.definition) !== protection.canonical(state.localOverride?.definition)) throw new Error("local definition does not match the installed wrapper");
        const view = protection.protectionView(state, state.projectRoot, process.env);
        const tools = view.state === protection.STATES.UNPROTECTED ? [] : protection.protectedToolNames(view);
        if (view.state === protection.STATES.ACTIVE && !coverageWrapperIsThisTree(view)) {
          console.log(`UNKNOWN ${label}: ${tools.join(", ")} — wrapper command does not resolve to this Seal tree; run coverage from the wrapper installation or reinstall protection with this binary`);
        } else if (view.state === protection.STATES.ACTIVE) {
          console.log(`BROKERED ${label}: ${tools.join(", ")} — inferred from a live lease and an owned override resolving to this Seal tree; no refusal probe was run`);
        } else {
          console.log(`UNKNOWN ${label}: ${tools.join(", ") || "none"} — protection state is ${view.state}, not a live wrapper lease`);
        }
      } else if (entries.some(({ definition }) => !definition || typeof definition !== "object" ||
          Array.isArray(definition) || !(typeof definition.command === "string" || typeof definition.url === "string"))) {
        console.log(`UNKNOWN ${label} — entry has no inspectable command or URL; ownership cannot be established`);
      } else {
        console.log(`UNBROKERED ${label} — configured without Seal; effective client selection is UNKNOWN`);
      }
    } catch (error) {
      console.log(`UNKNOWN ${label} — wrapper enforcement could not be established: ${error.message}`);
      process.exitCode = 1;
    }
  }
  // Retain diagnostics for orphaned records without duplicating configured rows.
  for (const [statePath, record] of records) {
    if (usedRecords.has(statePath)) continue;
    printObservedClient(record.state);
    console.log(`UNKNOWN selected MCP tools at ${statePath} — wrapper enforcement could not be established: ${record.error?.message || "record has no matching configured server"}`);
    process.exitCode = 1;
  }
  if (recordsError && byName.size === 0) {
    console.log(`UNKNOWN selected MCP tools — protection records could not be enumerated: ${recordsError.message}`);
    process.exitCode = 1;
  }
  if (byName.size === 0) console.log("UNKNOWN selected MCP tools — no configured MCP servers could be enumerated");
  coverageOutsideRoutes();
}

function coverageWrapperIsThisTree(view) {
  const command = view.localOverride?.definition?.command;
  // Protect installs an absolute executable path. Ambiguous PATH lookups or
  // relative commands cannot establish which installation the client launches.
  if (typeof command !== "string" || !path.isAbsolute(command)) return false;
  try {
    return fs.realpathSync(command) === fs.realpathSync(path.join(ROOT, "bin", "seal"));
  } catch {
    return false;
  }
}

function coverageOutsideRoutes() {
  // These four are deliberately named by protectionBoundary's existing
  // "Not controlled" output.  The other routes stay UNKNOWN: absence of a
  // record that Seal mediates them is not evidence that they cannot exist.
  console.log('UNBROKERED direct shell — "Bash and subprocesses outside this MCP route"');
  console.log('UNBROKERED spawned subprocesses — "Bash and subprocesses outside this MCP route"');
  console.log('UNBROKERED alternate MCP endpoints — "other MCP servers not routed through this Seal wrapper"');
  console.log('UNBROKERED direct resource access — "direct resource access outside this MCP route"');
  console.log('UNBROKERED other clients — "other clients"');
  console.log("UNKNOWN network");
  console.log("UNKNOWN cached tool handles");
  console.log("UNKNOWN in-process calls");
  console.log("UNKNOWN autonomous background effects");
  console.log("UNKNOWN non-tools/call methods");
  console.log("UNKNOWN unselected tools/call methods");
  console.log("UNKNOWN server-to-client requests (sampling/createMessage) — wrapper relays server output without filtering; downstream effects were not established");
}

function printObservedClient(state) {
  const client = state?.observedClient;
  if (!client || typeof client.name !== "string" || typeof client.version !== "string"
      || typeof client.elicitationDeclared !== "boolean") return;
  // Self-asserted strings must not inject additional terminal lines or controls.
  const { escapeInvisible } = require(path.join(ROOT, "contract", "renderer.cjs"));
  const { capClientMetadata } = require(path.join(ROOT, "spine", "presentation.cjs"));
  // Re-cap legacy state too; escaping controls can expand the stored byte count.
  const display = (value) => capClientMetadata(escapeInvisible(capClientMetadata(value), { preserveShaping: false }));
  console.log(`Observed client: ${display(client.name)} ${display(client.version)} (self-asserted, unsigned)`);
  console.log(`Elicitation declared: ${client.elicitationDeclared ? "yes" : "no"}`);
}

function statusRecord(recordPath, projectRoot, readError) {
  const protection = require(path.join(ROOT, "spine", "protection.cjs"));
  let receiptDir;
  let stateRead = false;
  let storedState;
  let stateRoot;
  let statePath;
  try {
    if (readError) throw readError;
    const root = fs.realpathSync(projectRoot);
    const filePath = recordPath;
    const state = filePath ? protection.readState(filePath) : null;
    stateRead = true;
    storedState = state;
    printObservedClient(state);
    stateRoot = root;
    statePath = filePath;
    if (typeof state?.receiptsDir === "string") receiptDir = state.receiptsDir;
    const view = protection.protectionView(state, root, process.env);
    if (!view || view.state === "UNPROTECTED") {
      for (const line of protection.protectionBoundary({ state: "UNPROTECTED", serverName: state?.serverName }, root, filePath)) console.log(line);
      console.log(state?.serverName ? "Receipts: unavailable for this route outside Seal" : "Receipts: unavailable outside a protected project");
      console.log(state?.serverName ? "Most recent: this route is outside Seal" : "Most recent: no project receipt directory is recorded");
      return;
    } else {
      const guarded = protection.protectedToolNames(view);
      for (const line of protection.protectionBoundary(view, root, filePath)) console.log(line);
      if (view.lease?.pid && view.lease?.generation !== undefined) {
        console.log(`Protection lease: pid ${view.lease.pid} generation ${view.lease.generation}`);
      }
      if (view.state === "DRIFTED") console.log("Protection detail: project .mcp.json server changed since protect; forwarding refused");
      if (view.state === "BROKEN") console.log(`Protection detail: ${view.brokenReason || "stored state is broken"}`);
      if (view.detail) console.log(`Protection detail: ${view.detail}`);
      if (view.state === "PENDING RESTART" || view.state === "STALE") printGuidance(protectGuidance(view.serverName, guarded));
      if (receiptDir === undefined) {
        console.log("Receipts: unavailable (protected project has no recorded receipt directory)");
        console.log("Most recent: no project receipt directory is recorded");
        return;
      }
    }
  } catch (error) {
    if (error.ownershipRefusal) {
      console.log(`REFUSED ${error.code}`);
      if (error.message) console.log(error.message);
      try {
        const state = recordPath ? protection.readState(recordPath) : null;
        printFailureGuidance("status", error, { serverName: state?.serverName }, (line) => console.log(line));
      } catch {}
      process.exitCode = 1;
      return;
    }
    if (!stateRead) {
      console.log("Stored protection state: could not be read");
      console.log(`Protection detail: ${error.message}`);
      console.log("Protected tool list: unreadable because the stored protection state could not be read");
      console.log("MCP routing: unknown because the stored protection state could not be read");
      console.log("Receipts: unavailable (receipt directory could not be resolved from broken protection state)");
      console.log("Most recent: unavailable because the project receipt directory could not be resolved");
      process.exitCode = 1;
      return;
    }
    if (receiptDir === undefined && typeof error.receiptDir === "string") receiptDir = error.receiptDir;
    // A later interpretation failure does not erase facts from the successful read.
    process.exitCode = 1;
    for (const line of protection.protectionBoundary(storedState, stateRoot, statePath)) console.log(line);
    console.log(`Protection detail: ${error.message}`);
    if (receiptDir === undefined) {
      console.log("Receipts: unavailable (receipt directory could not be resolved from broken protection state)");
      console.log("Most recent: unavailable because the project receipt directory could not be resolved");
      return;
    }
  }

  let population;
  try {
    const directory = fs.statSync(receiptDir);
    if (!directory.isDirectory()) {
      console.log(`Receipts: unavailable in ${receiptDir} (path is not a directory)`);
      console.log("Most recent: receipts cannot be stored because the receipt path is not a directory; check its configuration");
      return;
    }
    if ((directory.mode & 0o444) === 0) throw new Error("receipt directory is unreadable");
    population = receiptPopulation.inspectReceiptDirectory(receiptDir);
  }
  catch (error) {
    if (error.code === "ENOENT") {
      console.log(`Receipts: no receipt files observed in ${receiptDir} (directory does not exist)`);
      console.log("Most recent: no receipt yet (receipt directory is missing)");
      return;
    }
    console.log(`Receipts: unavailable in ${receiptDir} (directory cannot be read)`);
    console.log("Most recent: receipts may exist, but the receipt directory cannot be read; check its permissions");
    return;
  }

  // Count and select from the same filename-validated population as `seal receipts`.
  const { receiptFiles: receiptEntries, nonMatchingFiles, rejectedFiles } = population;
  for (const file of rejectedFiles) console.log(`Receipt file rejected: ${file.name} (${file.reason})`);
  if (receiptEntries.length === 0) {
    if (nonMatchingFiles.length === 0) {
      console.log("Receipts: no receipt files observed (receipt directory has no receipt-shaped files)");
    } else {
      console.log(`Receipts: no receipt files observed (${nonMatchingFiles.length} non-receipt files ignored)`);
    }
    console.log(receiptPopulation.unknownLine());
    console.log("Most recent: no receipt yet (receipt directory has no receipt-shaped files; no decision has been recorded)");
    return;
  }
  console.log(`Receipts: ${receiptEntries.length} receipt files observed in ${receiptDir}; run \`seal receipts ${receiptDir}\` to inspect sequence gaps; completeness UNKNOWN (receipt filenames are not signed)`);
  const observed = [];
  for (const entry of receiptEntries) {
    const target = path.join(receiptDir, entry.name);
    let stat;
    try { stat = fs.statSync(target); } catch (error) {
      console.log(`Receipt unreadable: ${entry.name} (${error.message})`);
      continue;
    }
    if (!stat.isFile()) {
      console.log(`Receipt unreadable: ${entry.name} (not a regular file)`);
      continue;
    }
    try {
      const receipt = JSON.parse(fs.readFileSync(target, "utf8"));
      if (receipt.seal_receipt !== "v2" || typeof receipt.verdict !== "string" || receipt.now === undefined) {
        throw new Error("missing v2 verdict or kernel time");
      }
      observed.push({ target, name: entry.name, verdict: receipt.action || receipt.verdict, now: receipt.now, mtimeMs: stat.mtimeMs });
    } catch (error) {
      console.log(`Receipt unreadable: ${entry.name} (${error.message})`);
    }
  }
  if (observed.length === 0) {
    console.log("Most recent: receipt files exist, but none could be read as a receipt");
    return;
  }
  observed.sort((a, b) => b.mtimeMs - a.mtimeMs);
  const recent = observed[0];
  // "by write time" names the sort: this is the newest receipt file, not a
  // verdict on any session. A demo writes several receipts (the last is the
  // replay refusal), so an unqualified "Most recent: BLOCK" could be misread
  // as "the run was blocked" when the approved call actually ran.
  console.log(`Most recent (by write time): ${recent.verdict} at receipt time ${recent.now} (${recent.name})`);
}
function receiptCommand(args) {
  if (args.length !== 1) throw new Error("usage: seal receipts DIRECTORY");
  const directory = path.resolve(args[0]);
  let stat;
  try { stat = fs.statSync(directory); } catch { throw new Error(`cannot inspect receipt directory: ${directory}`); }
  if (!stat.isDirectory()) throw new Error(`receipt path is not a directory: ${directory}`);
  return receiptPopulation.run(directory);
}
function shellWord(value) {
  return /^[A-Za-z0-9_./:-]+$/.test(value) ? value : `'${value.replaceAll("'", "'\\''")}'`;
}
function sealOnPath() {
  const current = fs.realpathSync(process.argv[1]);
  for (const directory of (process.env.PATH || "").split(path.delimiter).filter(Boolean)) {
    const candidate = path.join(directory, process.platform === "win32" ? "seal.cmd" : "seal");
    try {
      if (fs.realpathSync(candidate) === current) return true;
    } catch {}
  }
  return false;
}
function printGuidance({ next = [], undo = [] }, writeLine = (line) => console.log(line)) {
  if (next.length > 0) {
    writeLine("Next:");
    for (const line of next) writeLine(`  ${line}`);
  }
  if (undo.length > 0) {
    writeLine("Undo:");
    for (const line of undo) writeLine(`  ${line}`);
  }
}
function joinedToolNames(toolNames) {
  return toolNames.map((name) => `${shellWord(name)}`).join(", ");
}
function protectGuidance(serverName, guardTools = []) {
  const guarded = guardTools.length > 0 ? `, including guarded tools: ${joinedToolNames(guardTools)}` : "";
  return {
    next: [
      "1. Restart Claude Code in this project.",
      "2. Run `seal status`.",
      "3. Expect ACTIVE while Claude Code runs this project's wrapper; STALE after the session exits.",
    ],
    undo: [`To clear protection for every guarded tool on server ${shellWord(serverName)}${guarded}, stop Claude Code, then run \`seal unprotect ${shellWord(serverName)}\`.`],
  };
}
function failureGuidance(command, error, context = {}) {
  const code = error?.code;
  if (command === "protect") {
    if (code === "already_protected") return ["Run `seal status` to see the current protection before changing it."];
    if (code === "project_server_absent" || code === "project_server_invalid" || code === "project_server_non_stdio") {
      return ["Fix this project's .mcp.json so the named server is a stdio MCP server, then retry protect."];
    }
    if (code === "local_override_exists") {
      return ["Remove or rename the existing local Claude Code MCP override for this server only if you want Seal to own it, then retry protect."];
    }
    if (code === "claude_unavailable" || code === "claude_install_failed") {
      return ["Make Claude Code's claude command available for this project, then retry protect."];
    }
    if (code === "protected_tool_absent") return ["Choose exact tool names from the observed tools list above, then retry protect."];
    if (code === "protected_server_start_failed" || code === "protected_server_initialize_failed" || code === "protected_server_tools_list_failed" || code === "protected_server_tools_empty") {
      return ["Fix the configured MCP server's startup and tools/list response. If it is only slow, retry protect with a larger timeout."];
    }
  }
  if (command === "unprotect") {
    if (code === "active_claude_session") return ["Stop the Claude Code session using this server, then retry unprotect."];
    if (code === "claude_remove_failed") return ["Make Claude Code's claude command available and able to remove the local override, then retry unprotect."];
    if (code === "local_override_drifted") return ["Restore the local Claude Code MCP override Seal installed, or leave it in place; Seal changed nothing."];
    if (code === "no_seal_owned_override") return ["Inspect the local Claude Code MCP override for this server; Seal changed nothing."];
  }
  if (command === "status") {
    if (code === "local_override_drifted") return ["Restore the local Claude Code MCP override Seal installed; status cannot report protection from a replaced override."];
  }
  return [];
}
function printFailureGuidance(command, error, context, writeLine = (line) => console.error(line)) {
  const next = failureGuidance(command, error, context);
  if (next.length > 0) printGuidance({ next }, writeLine);
}
const { printKernelTiming } = require(path.join(ROOT, "spine", "presentation.cjs"));
function ask(question) {
  return new Promise((resolve) => {
    const input = readline.createInterface({ input: process.stdin, output: process.stderr });
    let answered = false;
    input.once("line", (line) => {
      answered = true;
      input.close();
      resolve({ kind: "answer", value: line.trim().toLowerCase() });
    });
    input.once("close", () => {
      if (!answered) resolve({ kind: "eof" });
    });
    input.output.write(question);
  });
}
// The demo, the hidden demo server and the protected-path proxy all live on
// the shared retry-model spine under spine/, consuming the merged approval
// contract in contract/. `seal demo` is wired ON TOP of the same
// proxy/contract/journal/receipt path the protected lane uses.
async function demo(args) {
  return require(path.join(ROOT, "spine", "demo.cjs")).run(args, __filename);
}
async function verify(args) {
  const receiptPath = args[0];
  const keyAt = args.indexOf("--pubkey");
  const json = args.includes("--json");
  // Keep the established usage diagnostic and exit outside JSON mode.
  if (!receiptPath && !json) throw new Error("usage: seal verify PATH");
  let result = {
    read: false, validate: false, replay: false, signature: false,
    authority: "NOT ESTABLISHED", occurrence: "NOT ESTABLISHED", verify: false,
  };
  let phase = "input";
  try {
    if (!receiptPath || receiptPath === "--json") throw new Error("usage: seal verify PATH");
    const absolute = path.resolve(receiptPath);
    let stat;
    try { stat = fs.statSync(absolute); } catch { throw new Error(`cannot inspect receipt path: ${absolute}`); }
    if (!stat.isFile()) throw new Error(`receipt path is not a regular file: ${absolute}`);
    if ((stat.mode & 0o444) === 0) throw new Error(`receipt file has no read permission bits: ${absolute}`);
    let text;
    try { text = fs.readFileSync(absolute); } catch { throw new Error(`cannot read receipt contents: ${absolute}`); }
    if (text.length === 0) throw new Error(`receipt is empty: ${absolute}`);
    phase = "runtime";
    const runtime = inspectRuntime();
    if (!runtime.present) throw new Error(`cannot verify receipt: local kernel runtime ${runtime.state} (${runtime.reason})`);
    const verifier = await import(pathToFileURL(path.join(ROOT, "checker", "seal-receipt-v2.mjs")).href);
    phase = "receipt";
    // read() retains the checker's UTF-8 and duplicate-member refusals.
    if (json) { verifier.read(text); result.read = true; }
    result = await verifier.verify(text, { publicKeyHex: keyAt > 0 ? args[keyAt + 1] : undefined });
    result.ok = result.validate && result.signature && result.replay;
    if (json) console.log(JSON.stringify({ ...result, code: result.ok ? null : "signature_unverifiable" }));
    else console.log(verifier.format(result));
    if (!result.ok) process.exitCode = 1;
  } catch (error) {
    // Classify existing verifier codes, without reimplementing its checks or
    // replacing its errors. 1 retains verification failures; 2 follows the
    // CLI's existing invalid-input convention (status/coverage arguments).
    const verificationFailure = new Set([
      "signature_mismatch", "commitment_mismatch", "verdict_mismatch",
      "action_verdict_mismatch", "inert_input",
    ]).has(error.code);
    const exitCode = phase === "runtime" || verificationFailure ? 1 : 2;
    if (!json) {
      // The outer handler owns the exact legacy stderr text and debug output.
      error.exitCode = exitCode;
      throw error;
    }
    // A refusal returns no partial verifier result. Only expose checks known
    // to have completed; false means not established, including not reached.
    console.log(JSON.stringify({
      ...result, ok: false,
      code: error.code || (phase === "input" ? "read_failed" : phase === "runtime" ? "runtime_unavailable" : "invalid_receipt"),
      message: error.message,
    }));
    process.exitCode = exitCode;
  }
}

async function sealBlock(args) {
  const emit = (code, fields) => {
    console.log(JSON.stringify({ seal_block: "v1", ok: false, authority: "NOT ESTABLISHED", occurrence: "NOT ESTABLISHED", verify: false, ...fields }));
    process.exitCode = code;
  };
  try {
    if (args.length !== 0 && !(args[0] === "--pubkey" && args.length <= 2)) {
      return emit(1, { error: "usage", message: "usage: seal seal_block [--pubkey HEX] < receipt.json" });
    }
    // Keep stdin as bytes: the verifier owns UTF-8 decoding, duplicate-member
    // rejection and the receipt specification's canonical signature checks.
    const bytes = fs.readFileSync(0);
    const runtime = inspectRuntime();
    if (!runtime.present) {
      return emit(runtime.state === "integrity check failed" ? 3 : 1,
        { error: runtime.state === "integrity check failed" ? "kernel_integrity" : "runtime_absent", message: runtime.reason });
    }
    const verifier = await import(pathToFileURL(path.join(ROOT, "checker", "seal-receipt-v2.mjs")).href);
    if (!verifier.hasPublicKey(args[1])) {
      return emit(5, { error: "no_key", message: "--pubkey requires 64 lowercase hexadecimal characters" });
    }
    const result = await verifier.verify(bytes, { publicKeyHex: args[1] });
    const ok = result.validate && result.signature && result.replay;
    emit(ok ? 0 : 1, { ...result, ok });
  } catch (error) {
    emit(1, { error: error.code || "invalid_receipt", message: error.message });
  }
}

function reproduce(args) {
  const sourceRoot = [ROOT, process.cwd()].find((candidate) => (
    fs.existsSync(path.join(candidate, "kernel-source")) &&
    fs.existsSync(path.join(candidate, "scripts", "seal-reproduce.cjs"))
  ));
  if (!sourceRoot) {
    console.error("REFUSE seal-reproduce <no-tag>: reproduce requires a Seal source checkout containing kernel-source/");
    process.exitCode = 1;
    return;
  }
  return reproduceOwner.main(args);
}

async function protectCommand(args) {
  requireProtectSupportedPlatform();
  const protection = require(path.join(ROOT, "spine", "protection.cjs"));
  let timeoutMs = protection.DEFAULT_TOOL_DISCOVERY_TIMEOUT_MS;
  const positional = [];
  for (let index = 0; index < args.length; index += 1) {
    const argument = args[index];
    if (argument === "--timeout-ms") {
      const value = args[index + 1];
      if (!value || !/^[1-9][0-9]*$/.test(value) || !Number.isSafeInteger(Number(value)) || Number(value) > 2147483647) {
        throw new protection.ProtectionError("usage", "--timeout-ms requires an integer from 1 to 2147483647");
      }
      timeoutMs = Number(value);
      index += 1;
    } else if (argument.startsWith("--")) {
      throw new protection.ProtectionError("usage", `unknown protect option: ${argument}`);
    } else {
      positional.push(argument);
    }
  }
  if (positional.length < 2) {
    throw new protection.ProtectionError("usage", "usage: seal protect [--timeout-ms MILLISECONDS] SERVER TOOL[?ARG=SCALAR|?ARG~\"PATTERN\"] [TOOL...]");
  }
  const [serverName, ...requestedTools] = positional;
  const guardTools = [...new Set(requestedTools)];
  const result = await protection.protect({ serverName, guardTools, projectRoot: process.cwd(), sealBin: fs.realpathSync(process.argv[1]), env: process.env, timeoutMs });
  console.log(`Project .mcp.json hash before protect: ${result.beforeHash}`);
  for (const line of protection.protectionBoundary(result.state, process.cwd(), result.statePath)) console.log(line);
  const guarded = new Set(result.state.guardTools);
  const outside = result.toolNames.filter((name) => !guarded.has(name));
  const shownOutside = outside.slice(0, 20);
  const hiddenOutside = outside.length - shownOutside.length;
  console.log(`Protection scope: ${outside.length} other tool${outside.length === 1 ? "" : "s"} NOT APPROVAL-GATED (they pass through Seal)${outside.length ? `: ${shownOutside.join(", ")}${hiddenOutside ? ` (+${hiddenOutside} more)` : ""}` : ""}`);
  console.log(`State: ${result.statePath}`);
  printGuidance(protectGuidance(serverName, result.state.guardTools));
}

function unprotectCommand(args) {
  const protection = require(path.join(ROOT, "spine", "protection.cjs"));
  const [serverName] = args;
  const result = protection.unprotect({ serverName, projectRoot: process.cwd(), env: process.env });
  console.log(`Project .mcp.json source before unprotect: ${result.projectSourceBefore}`);
  console.log(`Project .mcp.json source after unprotect: ${result.projectSourceAfter}`);
  console.log(`Project .mcp.json hash before unprotect: ${result.beforeHash}`);
  console.log(`Project .mcp.json hash after unprotect: ${result.afterHash}`);
  for (const line of protection.protectionBoundary({ ...(result.previousState || {}), state: "UNPROTECTED" }, process.cwd(), result.statePath)) console.log(line);
  const guardTools = protection.protectedToolNames(result.previousState || {});
  const undo = guardTools.length > 0
    ? [`Run \`seal protect ${shellWord(serverName)} ${guardTools.map(shellWord).join(" ")}\`.`]
    : [];
  printGuidance({
    next: [
      "1. Run `seal status`.",
      "2. Confirm the sealed MCP route is outside Seal.",
    ],
    undo,
  });
}

function recoverCommand(args) {
  requireProtectSupportedPlatform();
  const protection = require(path.join(ROOT, "spine", "protection.cjs"));
  if ((args.length !== 1 && args.length !== 2) || args[0] !== "--archive") {
    throw new protection.ProtectionError("usage", "usage: seal recover --archive [SERVER]; stop Claude Code first; this archives incompatible state and removes Seal's owned local override, leaving the route outside Seal");
  }
  const result = protection.recover({ serverName: args[1], projectRoot: process.cwd(), env: process.env });
  console.log(`Archived incompatible protection state: ${result.archivePath}`);
  console.log("Existing approval journal, receipts and signing keys were retained.");
  for (const line of protection.protectionBoundary({ ...result.previousState, state: "UNPROTECTED" }, process.cwd())) console.log(line);
  console.log("Next: review the archived server and tool selections, then run seal protect SERVER TOOL [TOOL...] in this project. Restart Claude Code and run seal status.");
}

function doctorCommand() {
  const protection = require(path.join(ROOT, "spine", "protection.cjs"));
  const result = protection.doctor(process.env);
  process.stdout.write(result.text);
  if (!result.ok) process.exitCode = 1;
}

async function main() {
  const command = process.argv[2];
  if (command === "--help" || command === "-h") return printHelp();
  if (command === "demo") return demo(process.argv.slice(3));
  // Private spine subcommands: not part of the command surface, not listed.
  if (command === "__demo-server") return require(path.join(ROOT, "spine", "demo-server.cjs")).run(process.argv[3]);
  if (command === "__proxy") return require(path.join(ROOT, "spine", "proxy-cli.cjs")).run(process.argv.slice(3));
  if (command === "verify") return verify(process.argv.slice(3));
  if (command === "seal_block") return sealBlock(process.argv.slice(3));
  if (command === "reproduce") return reproduce(process.argv.slice(3));
  if (command === "protect") return protectCommand(process.argv.slice(3));
  if (command === "uninstall") return require(path.join(ROOT, "spine", "uninstall.cjs")).run(process.argv.slice(3), ask);
  if (command === "unprotect") return unprotectCommand(process.argv.slice(3));
  if (command === "recover") return recoverCommand(process.argv.slice(3));
  if (command === "history") return receiptPopulation.queryCommand(process.argv.slice(3));
  if (command === "receipts") return receiptCommand(process.argv.slice(3));
  if (command === "doctor") return doctorCommand();
  if (command === "coverage") {
    if (process.argv.length > 3) { console.error("seal coverage takes no arguments"); process.exitCode = 2; return; }
    return coverage();
  }
  if (command === "status") {
    if (process.argv.length > 3) { console.error("seal status takes no arguments"); process.exitCode = 2; return; }
    return status();
  }
  if (command === "--version" || command === "-V") return console.log(requireMatchingVersion());
  if (command) console.error(`seal: unknown command: ${command}`);
  printHelp();
  process.exitCode = command ? 2 : 0;
}
function printHelp() {
  console.log(`seal — the developer gate

  seal protect [--timeout-ms MILLISECONDS] SERVER
      TOOL[?ARG=SCALAR|?ARG~"PATTERN"] [TOOL...]
      install a local Claude Code override for selected calls
      (server discovery timeout: 1..2147483647ms; default 30000ms per phase)
  seal unprotect SERVER
      remove the local override without touching .mcp.json
  seal recover --archive [SERVER]
      archive incompatible state and remove Seal's owned local override
  seal history DIRECTORY [--limit 1..100] [--tool NAME]
      [--since EPOCH_MS] [--until EPOCH_MS]
      count files and list recent claims (default 20; context UNKNOWN)
  seal receipts DIRECTORY
      inspect receipt filename sequences for observed gaps
  seal uninstall            preview and confirm removal of this installation
  seal doctor
      show approval-origin assumptions
  seal coverage
      report known mediated and unmediated routes for this deployment
  seal demo [--dir PATH]
      show one exact call run once and its replay blocked
  seal seal_block [--pubkey HEX] < receipt.json
      check stdin receipt bytes and emit a v1 JSON result
  seal verify PATH [--pubkey HEX] [--json]
      inspect a saved kernel receipt and re-derive its recorded decision
  seal reproduce TAG [--source PATH] [--platform linux-x64]
      [--authority same-authority|independent] [--authority-name NAME]
      compare artifact kernel bytes from a Seal source checkout
    seal reproduce build-pinned-kernel TAG --output PATH
        [--source PATH] [--manifest PATH]
        rebuild the selected kernel into PATH
  seal status
      show this project's protection plus local runtime and receipt state
  seal --help, -h
      show this help (also the default with no command)
  seal --version, -V
      show the matching product version

  Exit codes: 0 success/reportable state;
              1 refusal, failure or incomplete verification;
              2 invalid input, unknown command or arguments to status.
  Unknown commands also print help.
  Status exits 0 for an unprotected or stale route;
  inspect its text to judge protection.
  Flag ranges, argument details and per-command exits: docs/reference/cli.md.
  Seal supports install, demo, receipt checking and Protect on Linux x86-64
  and macOS x64/arm64.`);
}
if (require.main === module) main().catch((error) => {
  if (error.ownershipRefusal) {
    console.error(`REFUSED ${error.code}`);
    if (error.message) console.error(error.message);
    printFailureGuidance(process.argv[2], error);
    process.exitCode = 1;
    return;
  }
  const prefix = typeof error.code === "string" ? `${error.refusal ? "REFUSE " : ""}${error.code}: ` : "";
  console.error(`seal: ${prefix}${error.message}`);
  printKernelTiming(error);
  printFailureGuidance(process.argv[2], error);
  if (process.env.SEAL_DEBUG) console.error(error.stack);
  process.exitCode = error.exitCode || 1;
});
